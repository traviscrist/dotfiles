{
  "settings": {
    "scriptMode": false
  },
  "mcpServers": {
    "cloudwatch": {
      "command": "/opt/homebrew/bin/uvx",
      "args": [
        "--with",
        "mcp<2",
        "--from",
        "git+https://github.com/awslabs/Log-Analyzer-with-MCP@70f3423635cc0d61996070dd92788f9b7d1f56fa",
        "cw-mcp-server",
        "--profile",
        "read-only",
        "--region",
        "us-west-2"
      ],
      "env": {
        "AWS_PROFILE": "read-only",
        "AWS_REGION": "us-west-2",
        "AWS_DEFAULT_REGION": "us-west-2"
      },
      "lifecycle": "lazy",
      "directTools": false
    },
    "lunchmoney": {
      "command": "/Users/travis/.ai/bin/lunchmoney-mcp",
      "env": {
        "LUNCHMONEY_TOKEN": "${LM_TOKEN}"
      },
      "lifecycle": "lazy",
      "directTools": false,
      "approveTools": [
        "lm_*_create",
        "lm_*_update",
        "lm_*_delete",
        "lm_budgets_upsert",
        "lm_plaid_accounts_fetch",
        "lm_transactions_group",
        "lm_transactions_ungroup",
        "lm_transactions_split",
        "lm_transactions_unsplit",
        "lm_transactions_attachment_upload"
      ]
    },
    "figma": {
      "command": "/opt/homebrew/bin/codex",
      "args": [
        "mcp-server",
        "-c",
        "sandbox_mode=\"read-only\"",
        "-c",
        "approval_policy=\"never\"",
        "-c",
        "model_reasoning_effort=\"low\"",
        "-c",
        "mcp_servers.betterstack.enabled=false",
        "-c",
        "mcp_servers.cloudflare.enabled=false",
        "-c",
        "mcp_servers.linear_redcrayon.enabled=false",
        "-c",
        "mcp_servers.linear_truevault.enabled=false",
        "-c",
        "mcp_servers.node_repl.enabled=false"
      ],
      "lifecycle": "lazy",
      "idleTimeout": 10,
      "directTools": [
        "codex",
        "codex-reply"
      ],
      "approveTools": [
        "codex",
        "codex-reply"
      ]
    },
    "homeassistant": {
      "url": "http://homeassistant.local:8123/api/mcp",
      "auth": "bearer",
      "bearerTokenEnv": "HA_MCP",
      "lifecycle": "lazy",
      "idleTimeout": 10,
      "directTools": false,
      "approveTools": true
    },
    "paper": {
      "url": "http://127.0.0.1:29979/mcp",
      "lifecycle": "lazy",
      "idleTimeout": 10,
      "directTools": false,
      "approveTools": false
    }
  }
}
